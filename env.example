# Campus Connect environment configuration (copy to .env and fill in).
# Powered by LAVIDA. NEVER commit real secrets or admin credentials.

# --- Core ---
SAVANA_SECRET_KEY=change-me-to-a-long-random-string
SAVANA_DEBUG=0
SAVANA_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
SAVANA_CSRF_TRUSTED_ORIGINS=https://yourdomain.com
SAVANA_SSL_REDIRECT=1
SAVANA_TZ=Africa/Blantyre

# --- Database ---
# Resolution order: SAVANA_DATABASE_URL (or DATABASE_URL) -> SAVANA_POSTGRES_* -> SQLite.
#
# Option A (recommended for hosted DBs such as Supabase): a single connection
# URL. In the Supabase dashboard go to Project Settings -> Database -> Connection
# string, pick "URI", and copy it. Use the Session/Transaction pooler host
# (port 6543) for most deployments, or the direct host (port 5432). Example:
# SAVANA_DATABASE_URL=postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# SSL is required by Supabase and enabled by default; override if needed:
# SAVANA_DB_SSLMODE=require
#
# Option B: discrete Postgres variables (self-hosted Postgres).
# SAVANA_POSTGRES_DB=campus
# SAVANA_POSTGRES_USER=campus
# SAVANA_POSTGRES_PASSWORD=
# SAVANA_POSTGRES_HOST=127.0.0.1
# SAVANA_POSTGRES_PORT=5432
#
# Leave all of the above unset to use the zero-config SQLite default.

# --- Uploads ---
SAVANA_MAX_UPLOAD_BYTES=8388608

# --- Email / notifications ---
SAVANA_FROM_EMAIL=orders@campusconnect.example

# --- First-run Super Admin (used by: manage.py savana_setup) ---
# Set these only for the initial setup, then unset them.
SAVANA_ADMIN_USER=admin
SAVANA_ADMIN_EMAIL=admin@yourdomain.com
SAVANA_ADMIN_PASSWORD=
